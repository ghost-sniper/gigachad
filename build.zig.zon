            .hash = "N-V-__8AAOj5TwB7cbD38OzT3MDLCVnrddaX80kE_mWyrfXf",
        },
        // libssh2 的加密后端。
        .mbedtls = .{
            .url = "https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-3.6.4/mbedtls-3.6.4-easy-make-lib.tar.xz",
            .hash = "N-V-__8AAH5NwAJ8yZnYrT0xWbfSINV2G26IrQqqpo0j5Cn0",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        "README.md",
    },
}
